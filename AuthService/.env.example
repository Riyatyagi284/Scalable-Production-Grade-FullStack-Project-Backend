# Copy this file to `.env.dev` (NOT `.env`).
# The app loads `.env.${NODE_ENV}` and the `dev` script sets NODE_ENV=dev.
#
# Quick start with the bundled compose file:
#   docker compose up -d
#   cp .env.example .env.dev   # then fill in PRIVATE_KEY (see scripts/generateKeys.mjs)
#   npm install
#   npx typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts
#   npm run dev

# --- HTTP ---
PORT=5501

# --- PostgreSQL ---
# Default user is `postgres` (NOT `root` — that is a MySQL convention; Postgres rejects it).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auth_service

# --- JWT / Auth ---
# Any sufficiently long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_SECRET=replace-me-with-a-random-32-byte-hex-string

# JWKS endpoint exposed by this service (used by other services to verify access tokens).
JWKS_URI=http://localhost:5501/.well-known/jwks.json

# RSA private key for signing access tokens (RS256). Generate with `node scripts/generateKeys.mjs`,
# then paste the contents of certs/private.pem here. Wrap in double quotes and use \n for line breaks.
# Example: PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"
PRIVATE_KEY=

# --- CORS / cookies ---
# Frontends allowed to call this service:
CLIENT_UI_DOMAIN=http://localhost:5173
ADMIN_UI_DOMAIN=http://localhost:5174

# Cookie domain for accessToken / refreshToken (use `localhost` in dev).
MAIN_DOMAIN=localhost
